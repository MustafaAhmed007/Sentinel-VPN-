# Sentinel-VPN Ω server example configuration
# Never put private keys, tokens, or production credentials in Git.
SENTINEL_LISTEN=:8080
SENTINEL_ENV=development
SENTINEL_WIREGUARD_INTERFACE=wg0
SENTINEL_UPLINK_INTERFACE=eth0
SENTINEL_P2P_PORT_MIN=20000
SENTINEL_P2P_PORT_MAX=40000
SENTINEL_P2P_LEASE_MINUTES=30
