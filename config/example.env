# Sentinel-VPN Ω server example configuration
# Never commit real private keys, tokens, or production credentials.
SENTINEL_ENV=production
SENTINEL_LISTEN=:8443
SENTINEL_API_TOKEN=GENERATE-A-LONG-RANDOM-TOKEN
SENTINEL_TLS_CERT=/etc/sentinel/tls/fullchain.pem
SENTINEL_TLS_KEY=/etc/sentinel/tls/privkey.pem
SENTINEL_WIREGUARD_INTERFACE=wg0
SENTINEL_UPLINK_INTERFACE=eth0
# WireGuard address on the client peer used for P2P DNAT, e.g. 10.66.66.2
SENTINEL_P2P_TARGET=10.66.66.2
SENTINEL_P2P_PORT_MIN=20000
SENTINEL_P2P_PORT_MAX=40000
SENTINEL_P2P_LEASE_MINUTES=30
