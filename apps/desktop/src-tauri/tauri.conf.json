{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sentinel-VPN Ω",
  "version": "0.1.0",
  "identifier": "com.mustafaahmed007.sentinelvpn",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sentinel-VPN Ω",
        "width": 760,
        "height": 760,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "category": "Network",
    "shortDescription": "Security-first self-hosted WireGuard VPN",
    "longDescription": "Sentinel-VPN Ω provides a lightweight Windows client with fail-closed firewall policy, WireGuard orchestration, DNS and IPv6 leak protection, diagnostics, and self-hosted server management.",
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "perMachine",
        "startMenuFolder": "Sentinel-VPN Ω"
      }
    }
  }
}
